{
  "schemaVersion": 1,
  "id": "sybu-debug",
  "version": "${version}",
  "name": "Sybu Debug",
  "description": "Client-side spectator detection for Meteor Client.",
  "authors": [
    "Havkz"
  ],
  "contact": {
    "sources": "https://github.com/Havkz/Sybu-Debug"
  },
  "icon": "assets/template/icon.png",
